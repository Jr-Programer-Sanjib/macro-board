# Port the API server listens on
PORT=8787

# Comma-separated list of origins allowed to call this API in production.
# In dev, leave this blank and the server allows http://localhost:5173 automatically.
ALLOWED_ORIGINS=

# Optional. Get a free key at https://www.jblanked.com/api/key/
# Used ONLY as a fallback when the Forex Factory feed is unreachable or rate-limited.
# Note: JBlanked's free tier is currently capped at 1 request/day, so treat this as
# an emergency backup, not a second live source.
JBLANKED_API_KEY=

# How long (ms) the server caches the weekly calendar before refetching.
# Forex Factory's unofficial export endpoint allows only ~2 requests / 5 minutes
# per IP, so keep this comfortably above that. Default: 4 minutes.
CACHE_TTL_MS=240000

# --- Alerts (Telegram) -------------------------------------------------------
# Master switch for the alert scheduler. Set to "true" to enable.
ALERTS_ENABLED=true

# Telegram bot token from @BotFather (create one with /newbot).
# Find it at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Your chat ID. Easiest way: send any message to your bot, then call
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read "chat": { "id": ... }.
TELEGRAM_CHAT_ID=

# How often (ms) the scheduler re-checks the cache for events entering the lead
# window. Default: 60 seconds.
ALERT_POLL_MS=60000

# How far ahead (ms) of "now" to consider an event "upcoming" for alerts.
# Default: 4 hours.
ALERT_WINDOW_MS=14400000

# --- Database ---------------------------------------------------------------
# Where to store event history + alert prefs. DATABASE_TYPE picks the backend:
#   sqlite            local file (default; zero setup, good for dev)
#   postgres|supabase Supabase/Neon/any Postgres via DATABASE_URL
#   turso             Turso edge SQLite via TURSO_URL + TURSO_AUTH_TOKEN
#   turso+supabase    PRIMARY Turso + SECONDARY Supabase: writes go to both,
#                     reads come from Turso and fail over to Supabase if it
#                     errors. (Any A+B combination of the above types works.)
# Leaving DATABASE_TYPE blank auto-selects: Postgres if DATABASE_URL is set,
# otherwise local SQLite.
DATABASE_TYPE=sqlite

# Turso — PRIMARY. URL from the Turso dashboard (libsql://yourapp.turso.io)
# and the auth token from the Tokens tab.
TURSO_URL=
TURSO_AUTH_TOKEN=

# Supabase — SECONDARY (or standalone Postgres with DATABASE_TYPE=supabase).
# Use the "connection string" / pooler URL from Database -> Connection.
# SUPABASE_DATABASE_URL=postgresql://postgres:PASSWORD@host:PORT/dbname
# (DATABASE_URL is used as a fallback/secondary if SUPABASE_DATABASE_URL is blank.)

# Path used only when DATABASE_TYPE=sqlite.
# SQLITE_FILE=./data/macro-board.db
