# Supabase Auth — needed for login/registration. Create a project at
# https://supabase.com, then copy from Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# API base URL — set to your deployed backend (Render) in production, e.g.
# https://macro-board-api.onrender.com. Leave blank in dev (Vite proxies /api).
VITE_API_BASE=